# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB. Leave blank (or let connection fail) to fall back to an ephemeral
# in-memory MongoDB so the app still runs for demos.
MONGODB_URI=mongodb://127.0.0.1:27017/resq

# Auth — CHANGE THIS. Must be at least 16 characters.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS / client origin
FRONTEND_URL=http://localhost:5173

# ─── AI (optional) ─────────────────────────────────────────────────────────
# The deterministic assessment engine always runs. The AI layer only adds a
# narrative summary + guidance on top, and the app works fine without it.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5

# ─── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Seeding ───────────────────────────────────────────────────────────────
# Used by `npm run seed` to create the development admin account.
SEED_ADMIN_EMAIL=admin@resq.io
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@resq.io
SEED_USER_PASSWORD=Demo@12345

# ─── Client (client/.env) ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
